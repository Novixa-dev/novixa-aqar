APP_NAME="Novixa Aqar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the public host (scheme + domain + port) exactly:
# Spatie medialibrary generates absolute /storage URLs from it, and a
# mismatch breaks every property photo.
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

MULTITENANCY=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aqar
DB_USERNAME=root
DB_PASSWORD=

STRIPE_KEY=
STRIPE_SECRET=
# Required in production so Stripe payment webhooks verify and record payments.
STRIPE_WEBHOOK_SECRET=
# Inbox for contact-form notifications (falls back to MAIL_FROM_ADDRESS).
CONTACT_INBOX_EMAIL=

BROADCAST_DRIVER=log
# sync/file are zero-dependency defaults so a fresh install works without
# Redis running - switch both to `redis` for any real deployment, since
# Horizon (installed, see composer.json) never runs jobs while
# QUEUE_CONNECTION=sync.
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
# Port 1025 is Mailpit locally. In production this depends on the host, not
# only on the mail provider: many PaaS platforms block the standard SMTP
# ports (25, 465, 587) outright to prevent spam, and a blocked port does not
# refuse the connection -- it hangs until the socket times out, so the
# symptom is a slow request and a TransportException, not a clear rejection.
#
# That is the live behaviour on Railway: port 587 to smtp.resend.com times
# out from inside the container. Resend publishes 2587 and 2465 as
# alternates for exactly this case, and 2587 is what the deployment uses.
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@novixa.dev"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (Railway Buckets in staging; any S3 provider
# works unchanged -- Cloudflare R2, Backblaze B2, Tigris, AWS S3 itself).
#
# AWS_BUCKET is the switch: leave it empty and the `media` and `documents`
# disks stay on the container's own disk, which is what local development,
# CI and the test suite want. Fill it in and both disks move to the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Base S3 API endpoint. Required for every provider except AWS itself.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Which disk Spatie MediaLibrary stores property photos on. Defaults to
# `public` (the local storage/app/public + storage:link setup). Set it to
# `media` to serve photos from the bucket.
MEDIA_DISK=

# Origin that bucket-hosted media URLs are built against. Only used when
# MEDIA_DISK=media.
#
# The bucket is private, so this is NOT the bucket's own address: media is
# served by this app's /media route, which redirects to a short-lived signed
# URL.
#
# Set it to the bare origin with NO path -- https://your-domain.example --
# and not to .../media. Laravel's S3 adapter appends the disk's root (which
# is `media`) to this value when it builds a URL, so the /media segment is
# already accounted for. Appending it here produces /media/media/... and
# every photo 404s.
MEDIA_URL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Reverb (installed, config/reverb.php) - was entirely absent from this
# template despite being a hard dependency for real-time broadcasting.
# BROADCAST_DRIVER stays `log` above by default (zero-dependency fresh
# install); set it to `reverb` once these are configured and the Reverb
# server is actually running (`php artisan reverb:start`).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Octane Configuration - RoadRunner is what's actually installed
# (spiral/roadrunner-* in composer.json); the Swoole PHP extension is not
# present, so OCTANE_SERVER=swoole fatally errors on `octane:start`.
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000

# AI text generation (property descriptions + the staff assistant).
#
# Optional. With no key both features compose their output locally, in the
# visitor's language -- that is a supported configuration, not a degraded
# one, and it is what the demo runs on. Supplying a key switches them to the
# provider. Any OpenAI-compatible endpoint works via OPENAI_BASE_URI.
OPENAI_API_KEY=
OPENAI_BASE_URI=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
# Deliberately short: these calls run inside a web request on a single
# Octane worker, so a slow provider must not hold the worker open.
OPENAI_TIMEOUT=20

# Integrations with no credentials in this product. Declared so their
# absence is a deliberate, visible state rather than a silent null.
# (United Kingdom market services carried over from the upstream codebase.)
BACKGROUND_CHECK_API_KEY=
BACKGROUND_CHECK_API_URL=
CREDIT_REPORT_API_KEY=
CREDIT_REPORT_API_URL=
INSURANCE_API_KEY=
INSURANCE_ENDPOINT=
POSTCODES_API_KEY=
POSTCODES_ENDPOINT=
LOCRATING_API_KEY=
ALLAGENTS_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
QUICKBOOKS_API_KEY=
QUICKBOOKS_ENDPOINT=
ACCOUNTING_SYSTEM=

# WalkScore API Configuration
#
# Walk Score covers the United States and Canada ONLY. Yemeni locations
# are flagged "Unsupported Country" by the provider itself (verified
# against Al Mukalla and Sana'a), so for this product's primary market
# there is no key that would make these scores real - leaving this empty
# is the correct, permanent configuration, and the property page renders
# its "walkability scores not available" state instead.
#
# A key is only worth setting for a US/Canada deployment. With no key the
# service returns null and makes no outbound request at all; it never
# invents a score, because a fabricated walkability number is
# indistinguishable from a real one to a visitor.
WALKSCORE_API_KEY=
WALKSCORE_BASE_URI=https://api.walkscore.com

# Neighborhood Data API Configuration
#
# The base URI below is a PLACEHOLDER, not a real endpoint. With no API
# key the service short-circuits and never calls it (see
# NeighborhoodDataService); without that guard every property-detail
# request blocked on a DNS timeout against api.example.com.
NEIGHBORHOOD_DATA_BASE_URI=https://api.example.com
NEIGHBORHOOD_DATA_API_KEY=
