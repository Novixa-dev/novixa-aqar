APP_NAME="Novixa Aqar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

MULTITENANCY=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=liberu_real_estate
DB_USERNAME=root
DB_PASSWORD=

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

BROADCAST_DRIVER=log
# sync/file are zero-dependency defaults so a fresh install works without
# Redis running - switch both to `redis` for any real deployment, since
# Horizon (installed, see composer.json) never runs jobs while
# QUEUE_CONNECTION=sync.
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@darhadhramaut.ye"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Reverb (installed, config/reverb.php) - was entirely absent from this
# template despite being a hard dependency for real-time broadcasting.
# BROADCAST_DRIVER stays `log` above by default (zero-dependency fresh
# install); set it to `reverb` once these are configured and the Reverb
# server is actually running (`php artisan reverb:start`).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Octane Configuration - RoadRunner is what's actually installed
# (spiral/roadrunner-* in composer.json); the Swoole PHP extension is not
# present, so OCTANE_SERVER=swoole fatally errors on `octane:start`.
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000

# WalkScore API Configuration
WALKSCORE_API_KEY=
WALKSCORE_BASE_URI=https://api.walkscore.com
# Neighborhood Data API Configuration
NEIGHBORHOOD_DATA_BASE_URI=https://api.example.com
NEIGHBORHOOD_DATA_API_KEY=
