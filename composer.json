{
    "name": "novixa/aqar",
    "type": "project",
    "description": "Novixa Aqar (عقاري) — bilingual real-estate platform for the Yemeni market, built on a customized Laravel/Filament foundation.",
    "keywords": [
        "laravel",
        "real-estate",
        "novixa"
    ],
    "homepage": "https://novixa.dev",
    "license": "MIT",
    "require": {
        "php": "^8.4|^8.5",
        "bezhansalleh/filament-shield": "~4.0",
        "bursteri/socialstream": "^7.0",
        "docusign/esign-client": "^8.0",
        "fakerphp/faker": "^1.23",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.0",
        "laravel/jetstream": "^5.1",
        "laravel/octane": "^2.3",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^4.0",
        "spatie/laravel-analytics": "^5.0",
        "spatie/laravel-googletagmanager": "^3.0",
        "spatie/laravel-medialibrary": "^11.7",
        "spatie/laravel-menu": "^4.2",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/menu": "^3.2",
        "spiral/roadrunner-cli": "^2.6.0",
        "spiral/roadrunner-http": "^3.3.0",
        "stripe/stripe-php": "^20.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "filament/upgrade": "^5.0",
        "laravel/pint": "^1.14",
        "laravel/sail": "^1.28",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "Aws\\Script\\Composer\\Composer::removeUnusedServices"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [
            "Aws\\Script\\Composer\\Composer::removeUnusedServices"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "aws/aws-sdk-php": [
            "S3"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
