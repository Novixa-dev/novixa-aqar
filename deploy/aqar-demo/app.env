# Novixa Aqar — aqar-demo.novixa.dev, non-secret configuration.
# Docker env-file syntax: no quotes, no ${VAR} interpolation.
#
# Copied to /opt/aqar-demo/app.env by .github/workflows/deploy-aqar-demo.yml
# on every deploy, so edit it here, not on the server. Secrets (APP_KEY,
# DB_PASSWORD) live only in /opt/aqar-demo/secrets.env, generated once by
# server-setup.sh, and are never committed.

APP_NAME=Novixa Aqar
# staging, not production: this is a demo box, and UserSeeder refuses to
# create the seeded demo personas (docs/TEST_USERS.md) in production.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://aqar-demo.novixa.dev

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=aqar-demo-db
DB_PORT=3306
DB_DATABASE=aqar
DB_USERNAME=aqar

# No Redis on this host: zero-dependency drivers. Cookie sessions survive a
# container swap during deploy because every release shares the same APP_KEY.
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# Demo box: outgoing mail is written to the log instead of sent, so a demo
# action that emails someone never fails on a missing SMTP server.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@novixa.dev
MAIL_FROM_NAME=Novixa Aqar

OCTANE_SERVER=roadrunner
OCTANE_HTTPS=true
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000

CONTAINER_MODE=http
WITH_HORIZON=false
WITH_REVERB=false
# Seeding is done by deploy.sh, not on every container boot.
RUNNING_MIGRATIONS_AND_SEEDERS=false

# Demo data version. Bump it when the seeded demo data changes and the next
# deploy rebuilds this demo's database from the seeders — into a fresh
# database beside the live one, switched over with zero downtime. Anything
# visitors changed on the demo is reset. 2 = demo logins moved to @novixa.dev;
# 3 = Novixa branding and all seeded contacts on @novixa.dev.
DEMO_SEED_VERSION=3
